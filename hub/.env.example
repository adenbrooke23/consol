# Copy to .env in this directory. One KEY=value per line, no quotes, no
# trailing comments. Variables already set in the process environment win.

# Client ID of your Spotify app (developer.spotify.com/dashboard).
SPOTIFY_CLIENT_ID=your-spotify-client-id

# Client secret of the same Spotify app.
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# OAuth redirect URI; must exactly match one registered on the Spotify app.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Network name shown in the app's Profile page (a name set from the app takes precedence).
NETWORK_NAME=Home network

# Apple TVs the hub must never control: comma-separated identifiers from GET /tv/devices, e.g. AA:BB:CC:DD:EE:FF,11:22:33:44:55:66.
PROTECTED_APPLE_TVS=

# Path to the SQLite database (default: data.db here). Process environment only: .env is loaded too late for it, and the keeper always uses data.db.
# HUB_DB=/path/to/data.db

# Set to 0 to stop the keeper starting the hub when it boots. Read by hubkeeper.py from its own environment (e.g. the launchd plist), not from this file.
# HUBKEEPER_AUTOSTART=1
